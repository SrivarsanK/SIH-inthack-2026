          }
        ]
      },
      {
        "matcher": "Bash|Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"C:/Program Files/nodejs/node.exe\" .agents/hooks/gsd-workflow-guard.js",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"C:/Program Files/nodejs/node.exe\" .agents/hooks/gsd-worktree-path-guard.js",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"C:/Program Files/Git/bin/bash.exe\" .agents/hooks/gsd-validate-commit.sh",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "read_file(~/Desktop/SIH-inthack-2026/.agents/gsd-core/*)",
      "read_file(~/Desktop/SIH-inthack-2026/.agents/agents/gsd-*)",
      "read_file(~/Desktop/SIH-inthack-2026/.agents/skills/gsd-*)",
      "command(node ~/Desktop/SIH-inthack-2026/.agents/hooks/*)"
    ]
  }
}
